  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Die Giraffe\r\n\r\nDie Giraffe steht am Mikrofon,\r\nsie singt mal schief
    mal graden Ton.\r\nSie findet nichts, was mehr gef\xE4llt,\r\nals sich selbst
    auf dieser gro\xDFen Welt.\r\n\r\nStolz streckt sie ihren Hals empor,\r\npr\xE4sentiert
    dabei noch Horn und Ohr.\r\nAuch gl\xE4nzen ihre Flecken hell.\r\nSch\xF6n schimmert
    doch ihr ganzes Fell.\r\n\r\nDie M\xE4hne ist ihr ganzes Gl\xFCck,\r\ndrum wirft
    sie ihren Hals zur\xFCck.\r\n\r\nSie t\xE4nzelt leicht, dreht sich herum,\r\ndoch
    pl\xF6tzlich, Hilfe! Oh nein, wie dumm,\r\nder Sahl dreht sich im Kreise rum,\r\nund
    plumms, da f\xE4llt sie auch schon um.\r\n\r\nDer lange Hals er saust hinab,\r\ndie
    G\xE4ste springen auf und ab.\r\nSie fl\xFCchten sich in alle Ecken,\r\ndurch
    Mark und Bein geht ihn\u2019n der Schrecken.\r\n\r\nEs gab noch einen lauten
    Knall,\r\ndoch dann Gel\xE4chter laut erschall.\r\nIhr Stolz brachte sie zu Fall.\r\nZu
    Ende war der sch\xF6ne Ball.\r\n\r\nDoch was die Giraffe daraus lernte,\r\nf\xFCr
    Stolz gibt es keine Ernte.\r\nDoch geht man mit Dankbarkeit nach Haus,\r\nso
    erntet man auch gro\xDFen Applaus.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
